#!/bin/zsh

# herdr-lazygit — feature-dir-aware git side-action launcher. Ported from
# tmux-lazygit. Supports two modes:
#   lazygit (default) — open lazygit          (bound to prefix+g)
#   pr                — open the PR on GitHub  (via git-opr; bound to prefix+G
#                                               through the herdr-git-pr shim)
#
# In a feature dir with sibling *backend/ and *frontend/ git repos, auto-picks
# whichever side has work in flight (uncommitted changes or commits ahead of its
# default remote branch). Falls back to an fzf chooser when both or neither are
# active. Because this whole script runs inside a single herdr popup, the fzf
# chooser and the action run sequentially in that same popup — no nested-popup
# dance (which tmux needed) is required.

set -e
setopt null_glob

mode="${1:-lazygit}"
case "$mode" in
  lazygit) prompt="lazygit ❯ " ;;
  pr)      prompt="open pr ❯ " ;;
  *)       print -- "Usage: ${0:t} [lazygit|pr]" >&2; exit 1 ;;
esac

current_path="${HERDR_ACTIVE_PANE_CWD:-$PWD}"

launch() {
  cd "$1"
  case "$mode" in
    lazygit) exec lazygit ;;
    pr)      exec git-opr ;;
  esac
}

# Case 1: inside a git repo — act on it directly.
if git -C "$current_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  launch "$current_path"
fi

# Case 2: sibling backend/frontend git repos under the current dir.
backend_dir=""
frontend_dir=""
for d in "$current_path"/*/; do
  d="${d%/}"
  if [[ -e "$d/.git" ]]; then
    case "${d:t}" in
      *backend)  backend_dir="$d" ;;
      *frontend) frontend_dir="$d" ;;
    esac
  fi
done

# A repo is "active" if it has uncommitted changes or is ahead of its default
# remote branch (origin/master, falling back to origin/main).
is_active() {
  local d="$1"
  [[ -n "$(git -C "$d" status --porcelain 2>/dev/null)" ]] && return 0
  local base
  for base in origin/master origin/main; do
    if git -C "$d" rev-parse --verify --quiet "$base" >/dev/null; then
      local ahead
      ahead=$(git -C "$d" rev-list --count "$base..HEAD" 2>/dev/null)
      [[ -n "$ahead" && "$ahead" -gt 0 ]] && return 0
      return 1
    fi
  done
  return 1
}

if [[ -n "$backend_dir" && -n "$frontend_dir" ]]; then
  backend_active=false
  frontend_active=false
  if is_active "$backend_dir"; then backend_active=true; fi
  if is_active "$frontend_dir"; then frontend_active=true; fi

  # Skip the chooser when exactly one side has work in flight.
  if $backend_active && ! $frontend_active; then launch "$backend_dir"; fi
  if $frontend_active && ! $backend_active; then launch "$frontend_dir"; fi

  # Both or neither active — fzf chooser, right here in the popup.
  sel=$(
    printf 'backend\t%s\nfrontend\t%s\n' "$backend_dir" "$frontend_dir" |
      fzf --reverse --with-nth=1 --delimiter=$'\t' --prompt="$prompt" \
          --height=100% --header='both/neither side dirty — pick one'
  ) || exit 0
  dir=${sel##*$'\t'}
  if [[ -n "$dir" ]]; then launch "$dir"; fi
  exit 0
fi

# Only one side present — act on whichever exists.
if [[ -n "$backend_dir" ]];  then launch "$backend_dir";  fi
if [[ -n "$frontend_dir" ]]; then launch "$frontend_dir"; fi

print -- "herdr-lazygit: no git repo here and no backend/frontend subdirs"
sleep 2
exit 1
