#!/usr/bin/env -S ruby --disable-gems -x

require 'optparse'
require 'open3'

class TabOpener
  TAB_NOT_FOUND = :tab_not_found

  def initialize(app_url, options)
    @app_url = app_url
    @options = options
  end

  def self.open_for(app_url, options)
    new(app_url, options).open!
  end

  def open!
    if tab_exists?
      log("Tab exists!")
      activate(app_tab)
      if options[:reload]
        log("Reloading tab")
        reload(app_tab)
      end
    else
      log("Tab not found -- opening anew")
      open_app_in_new_tab
    end
    unless options[:detached]
      focus_chrome
    end
  end

  private

  attr_reader :app_url, :options

  def app_tab
    @app_tab ||=
      begin
        output = `/opt/homebrew/bin/chrome-cli list links`.chomp
        matching_line = output.lines.find { |line| line.include?(app_url) }
        if matching_line && (match = matching_line.match(/\[(\d+)\]/))
          match[1]
        else
          TAB_NOT_FOUND
        end
      end
  end

  def open_app_in_new_tab
    # try_system_cmd "/opt/homebrew/bin/chrome-cli open #{app_url} > /dev/null 2>&1"
    try_system_cmd "/opt/homebrew/bin/chrome-cli open #{app_url}"
  end

  def tab_exists?
    app_tab != TAB_NOT_FOUND
  end

  def activate(tab_id)
    try_system_cmd "/opt/homebrew/bin/chrome-cli activate -t #{tab_id}"
  end

  def reload(tab_id)
    try_system_cmd "/opt/homebrew/bin/chrome-cli reload -t #{tab_id}"
  end

  def focus_chrome
    try_system_cmd "open -a 'Google Chrome'"
  end

  def try_system_cmd(cmd)
    Open3.popen3(cmd) do |_, stdout, stderr, wait_thr|
      output = stdout.read
      error = stderr.read
      exit_status = wait_thr.value

      if exit_status != 0
        log("Error: system command failed ['#{cmd}']")
        log("  stdout: #{output}")
        log("  stderr: #{error}")
      end
    end
  end
end

def desired_app_url
  if app_url = ARGV[0]
    app_url
  else
    project_name = Dir.pwd.split("/").last
    "http://#{project_name}.dev"
  end
end

options = {}
OptionParser.new do |opts|
  opts.banner = "Usage: open-tab [options] [<tab-url>]"

  opts.on("-r", "--[no-]reload", "Reload tab after activating") do |r|
    options[:reload] = r
  end

  opts.on("-d", "--detached", "Detached -- do not focus chrome") do |d|
    options[:detached] = d
  end
end.parse!

def logging_enabled?
  false
end

def log(message)
  if logging_enabled?
    puts message
  end
end

TabOpener.open_for(desired_app_url, options)
