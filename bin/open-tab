#!/usr/bin/env bash

# Focus the first Chrome tab whose URL contains <tab-url>, or open it in a new
# tab of the front window. Defaults to http://<current dir name>.dev.

set -u

usage() {
  cat <<EOF
Usage: open-tab [options] [<tab-url>]
    -r, --[no-]reload                Reload tab after activating
    -d, --detached                   Detached -- do not focus chrome
EOF
}

reload=0
detached=0
url=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -r | --reload) reload=1 ;;
    --no-reload) reload=0 ;;
    -d | --detached) detached=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      [[ -z "$url" && $# -gt 0 ]] && url="$1"
      break
      ;;
    -*)
      echo "open-tab: invalid option: $1" >&2
      usage >&2
      exit 1
      ;;
    *) [[ -z "$url" ]] && url="$1" ;;
  esac
  shift
done

url="${url:-http://$(basename "$PWD").dev}"

/usr/bin/osascript - "$url" "$reload" "$detached" >/dev/null 2>&1 <<'APPLESCRIPT'
on run argv
  set target to item 1 of argv
  set doReload to (item 2 of argv is "1")
  set doFocus to (item 3 of argv is "0")
  tell application "Google Chrome"
    set found to false
    set windowUrls to URL of tabs of every window
    considering case
      repeat with w from 1 to count of windowUrls
        set tabUrls to item w of windowUrls
        repeat with t from 1 to count of tabUrls
          if (item t of tabUrls) contains target then
            set win to window w
            set active tab index of win to t
            set index of win to 1
            if doReload then reload tab t of win
            set found to true
            exit repeat
          end if
        end repeat
        if found then exit repeat
      end repeat
    end considering
    if not found then
      if (count of windows) is 0 then
        make new window
        set URL of active tab of front window to target
      else
        tell front window to make new tab with properties {URL:target}
      end if
    end if
    if doFocus then activate
  end tell
end run
APPLESCRIPT
