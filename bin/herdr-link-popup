#!/bin/zsh
# Confirm-and-copy a moimenubar:// deep link for the pane you fired the hotkey
# from — bound to prefix+y, so it works while you are sitting in a session.
# herdr passes popups the source pane in HERDR_ACTIVE_PANE_ID, and
# `herdr pane get` turns that into the Claude session id, cwd, tab and
# workspace.
#
# Chat or feature is not a choice: claude-session-link decides it the way
# herdr already splits the two — a feature worktree is a feature, anywhere
# else is a chat. The popup only shows what you are about to copy.
#
#   enter (ctrl+m) copy markdown   ctrl+r copy rich text
#   x              arm/disarm closing the source tab (workspace, for a
#                  feature) after the copy — the banner says so loudly while
#                  it is armed, since it is the one irreversible bit here
#   esc / q        cancel
#
# ctrl+m and enter are the same byte outside the kitty protocol, which is why
# markdown is bound to enter rather than being a mode you toggle first.
set -e

pane="${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}"
[ -z "$pane" ] && { print -u2 "no active pane"; exit 1; }

info=$(herdr pane get "$pane" </dev/null)
sid=$(printf '%s' "$info" | jq -r '.result.pane.agent_session.value // empty')
cwd=$(printf '%s' "$info" | jq -r '.result.pane.cwd // empty')
src_tab=$(printf '%s' "$info" | jq -r '.result.pane.tab_id // empty')
src_ws=$(printf '%s' "$info" | jq -r '.result.pane.workspace_id // empty')
[ -z "$cwd" ] && { print -u2 "no cwd for pane $pane"; exit 1; }

bold=$'\e[1m' dim=$'\e[2m' off=$'\e[0m' accent=$'\e[36m' ok=$'\e[32m'
warn=$'\e[1;7;33m'

fail() {
  printf '\e[H\e[2J'
  print "\n  $1\n"
  print "  ${dim}${cwd}${off}\n"
  print "  ${dim}any key to close${off}"
  read -s -k 1
  exit "${2:-0}"
}

# One call decides chat vs feature and builds the link; the "[Chat: …]" /
# "[Feature: …]" prefix is what it decided, so the popup never re-derives it.
# With no session on this pane the only honest answer is the feature: asking
# for a chat link would fall back to whatever session ran in this directory
# last, which is not the one you are looking at.
local_args=("$sid" "$cwd")
[ -z "$sid" ] && local_args=(--feature "" "$cwd")
link=$(claude-session-link "${local_args[@]}" 2>/dev/null) \
  || fail "Nothing to link here — no Claude session, and not a feature worktree."
text=$(printf '%s' "$link" | sed -E 's/^\[(.*)\]\(.*\)$/\1/')
url=$(printf '%s' "$link" | sed -E 's/^\[.*\]\((.*)\)$/\1/')
kind="${text%%:*}"
name="${text#*: }"

close=""

draw() {
  printf '\e[H\e[2J'
  local after xhint what
  if [ -n "$close" ]; then
    if [ "$kind" = Feature ]; then what="THIS WORKSPACE"; else what="THIS TAB"; fi
    after="${warn}  ⚠  CLOSES ${what} AFTER COPYING  ${off}"
    xhint="${dim}x${off} keep open"
  else
    after="${dim}after copy   leave everything open${off}"
    xhint="${dim}x${off} close after"
  fi
  print ""
  print "  ${bold}Copy link${off}"
  print ""
  print "  ${accent}${kind}${off}   ${bold}${name}${off}"
  print "  ${dim}${url}${off}"
  print ""
  print "  ${after}"
  print ""
  print "  ${dim}enter${off} markdown   ${dim}ctrl-r${off} rich text   ${xhint}   ${dim}esc${off} cancel"
}

copy() {  # $1: format flag, $2: label
  local -a args=("$1")
  [ -n "$close" ] && args+=(--close)
  args+=("${local_args[@]}")
  # --close must act on the pane we were fired from, not this popup's own tab.
  if HERDR_TAB_ID="$src_tab" HERDR_WORKSPACE_ID="$src_ws" \
       claude-session-link "${args[@]}" >/dev/null 2>&1; then
    printf '\e[H\e[2J'
    print "\n  ${ok}✓${off} Copied as $2."
    [ -n "$close" ] && print "  ${dim}closing…${off}"
    sleep 0.7
    exit 0
  else
    fail "Could not copy that link." 1
  fi
}

while true; do
  draw
  read -s -k 1 key || exit 0
  case "$key" in
    $'\r'|$'\n') copy --copy markdown ;;
    $'\C-r')     copy --rich "rich text" ;;
    x|X)         [ -n "$close" ] && close="" || close=1 ;;
    q|Q|$'\e'|$'\C-c') exit 0 ;;
  esac
done
