#!/bin/zsh
# Open a Claude session by id from outside herdr — what a
# moimenubar://chats/<project>/<slug>-<session id> link resolves to (the Moi
# menubar app runs this). In order:
#   live in herdr        -> focus its tab and pane
#   started in a worktree -> resume it in that worktree's workspace (opening
#                           the workspace if the worktree is not open yet)
#   otherwise            -> resume it in the project's root workspace through
#                           herdr-new-thread --launch
# Exits 2 with a message on stderr when no transcript exists for the id, so
# the caller can surface that instead of a tab that opens and vanishes.
#
#   herdr-open-chat PROJECT SESSION_ID [NAME]
#     PROJECT: august | moi | dotfiles
#     NAME:    tab label for a resumed session (default: the session id)
set -e
usage="usage: herdr-open-chat PROJECT SESSION_ID [NAME]"
project="${1:?$usage}"
session_id="${2:?$usage}"
name="${3:-$session_id}"

project_root() {
  case "$1" in
    august)   augie-path root ;;
    moi)      echo "$HOME/code/moi" ;;
    dotfiles) echo "$HOME/code/dotfiles" ;;
    *) echo "unknown project: $1" >&2; return 2 ;;
  esac
}

first_pane() {
  jq -r '[.. | objects | select(has("pane_id")) | .pane_id][0] // empty'
}

# Workspace id for the worktree checked out at $1 under the repo at $2,
# opening it in herdr first if it is only on disk. Empty when no worktree
# lives there.
worktree_workspace() {
  local wt_path="$1" root="$2" list ws source
  local -a from
  list=$(herdr worktree list --cwd "$root" </dev/null)
  ws=$(printf '%s' "$list" | jq -r --arg p "$wt_path" '.result.worktrees[] | select(.path == $p) | .open_workspace_id // "open-me"')
  case "$ws" in
    "") ;;
    open-me)
      source=$(printf '%s' "$list" | jq -r '.result.source.source_workspace_id // empty')
      from=(--cwd "$root")
      [ -n "$source" ] && from=(--workspace "$source")
      herdr worktree open "${from[@]}" --path "$wt_path" --label "${wt_path:t}" --focus </dev/null >/dev/null
      ws=$(herdr worktree list --cwd "$root" </dev/null | jq -r --arg p "$wt_path" '.result.worktrees[] | select(.path == $p) | .open_workspace_id // empty')
      ;;
  esac
  printf '%s' "$ws"
}

# herdr-agent-resume owns the agent-start races and naming.
resume_in() {
  local ws="$1" cwd="$2" pane
  pane=$(herdr tab create --workspace "$ws" --cwd "$cwd" --label "$name" --env HERDR_THREAD=1 --focus </dev/null | first_pane)
  [ -z "$pane" ] && { echo "tab create returned no pane" >&2; return 1; }
  herdr-agent-resume "$pane" "$session_id" "$name"
}

transcripts=("$HOME"/.claude/projects/*/"$session_id.jsonl"(N))
transcript="${transcripts[1]:-}"
if [ -z "$transcript" ]; then
  echo "no Claude session $session_id on this machine" >&2
  exit 2
fi

open -a Ghostty

live=$(
  herdr agent list </dev/null | jq -r --arg id "$session_id" '
    .result.agents[]
    | select(.agent == "claude" and .agent_session.value == $id)
    | "\(.tab_id) \(.pane_id)"' | head -n1
)
if [ -n "$live" ]; then
  # Tab first, then the pane: agent focus alone does not always raise the tab
  # in a multi-tab workspace (same two-step herdr-new-thread uses).
  herdr tab focus "${live%% *}" >/dev/null
  herdr agent focus "${live##* }" >/dev/null
  exit 0
fi

root=$(project_root "$project")
cwd=$(grep -m1 -o '"cwd":"[^"]*"' "$transcript" | head -n1 | cut -d'"' -f4)
ws=""
if [ -n "$cwd" ] && [ "$cwd" != "$root" ] && [ -d "$cwd" ]; then
  ws=$(worktree_workspace "$cwd" "$root")
fi

log="$HOME/.config/herdr/new-thread.log"
if [ -n "$ws" ]; then
  # Detached like the popup's own submit: claude takes seconds to boot and
  # the caller (menubar app, Leader Key) should not wait on it.
  nohup zsh -c "$(typeset -f resume_in first_pane); name=${(q)name}; session_id=${(q)session_id}; resume_in ${(q)ws} ${(q)cwd}" >>"$log" 2>&1 &!
else
  printf '{"project":"%s"}' "$project" |
    nohup herdr-new-thread --launch "$name" open "$session_id" >>"$log" 2>&1 &!
fi
