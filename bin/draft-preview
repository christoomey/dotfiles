#!/bin/zsh
# Preview a markdown draft beside the current herdr pane, re-rendering on
# every call. The preview pane belongs to the calling pane, not the draft, so
# a conversation has one preview split however many draft files it shows:
# a second file replaces the first in the same pane.
#
#   draft-preview FILE            glow in a right split (reused if still open)
#   draft-preview --marked FILE   Marked 2 (images/videos, or outside herdr)
#   draft-preview --close [FILE]  close the preview pane (and re-enter layout)
#                                 and FILE's Marked window (all Marked previews
#                                 this pane opened, without FILE)
#
# glow needs -s when piped (it falls back to notty otherwise), and -t renders
# blank in herdr, hence the pager.
set -eu

mode=glow
case "${1:-}" in
  --marked) mode=marked; shift ;;
  --close) mode=close; shift ;;
esac
if [ "$mode" = close ]; then
  file=${1:-}
else
  file=${1:?usage: draft-preview [--marked|--close] FILE}
  [ -f "$file" ] || { echo "usage: draft-preview [--marked|--close] FILE (no file: $file)" >&2; exit 2; }
  file=${file:A}
fi
state_dir="${TMPDIR:-/tmp}/draft-preview/${${HERDR_PANE_ID:-none}//[^A-Za-z0-9]/_}"
state="$state_dir/pane"
layout_state="$state_dir/layout"
marked_state="$state_dir/marked"
layout_bin=( ~/.config/herdr/plugins/github-installations/coryfklein.herdr-layout-*/*/checkout/bin/herdr-layout(N) )

close_marked() {
  pgrep -xq "Marked 2" || return 0
  osascript - "$@" <<'APPLESCRIPT' >/dev/null
on run argv
  tell application "Marked 2"
    repeat with p in argv
      repeat with d in (documents whose path is (p as text))
        close d
      end repeat
    end repeat
  end tell
end run
APPLESCRIPT
}

mkdir -p "$state_dir"

if [ "$mode" = marked ] || { [ "$mode" = glow ] && [ -z "${HERDR_PANE_ID:-}" ]; }; then
  open -a "Marked 2" "$file"
  grep -qxF -- "$file" "$marked_state" 2>/dev/null || print -r -- "$file" >>"$marked_state"
  exit
fi

if [ "$mode" = close ]; then
  if [ -n "$file" ]; then
    marked_files=( ${file:A} )
  elif [ -f "$marked_state" ]; then
    marked_files=( ${(f)"$(<"$marked_state")"} )
  else
    marked_files=()
  fi
  [ ${#marked_files} -gt 0 ] && close_marked "${marked_files[@]}"
  if [ -f "$marked_state" ]; then
    remaining=( ${(f)"$(grep -vxF -f <(print -rl -- "${marked_files[@]}") "$marked_state" || true)"} )
    if [ ${#remaining} -gt 0 ]; then
      print -rl -- "${remaining[@]}" >"$marked_state"
    else
      rm -f "$marked_state"
    fi
  fi
  [ -z "${HERDR_PANE_ID:-}" ] && exit
fi

pane=""
[ -f "$state" ] && pane=$(<"$state")
if [ -n "$pane" ] && ! herdr pane get "$pane" >/dev/null 2>&1; then
  pane=""
fi

if [ "$mode" = close ]; then
  [ -n "$pane" ] && herdr pane close "$pane" >/dev/null
  rm -f "$state"
  if [ -f "$layout_state" ]; then
    layout_pane=$(<"$layout_state")
    if [ ${#layout_bin} -eq 0 ] || ! HERDR_PANE_ID=$layout_pane "${layout_bin[1]}" enter; then
      echo "draft-preview: could not re-enter herdr-layout" >&2
    fi
    rm -f "$layout_state"
  fi
  exit
fi

if [ -z "$pane" ]; then
  # herdr-layout margin panes squeeze the split; leave layout mode first.
  tab=$(herdr pane get "$HERDR_PANE_ID" | jq -r '.result.pane.tab_id // .result.tab_id // empty')
  if herdr pane list | jq -e --arg t "$tab" 'any(.result.panes[]; .tab_id == $t and .label == "Layout spacer")' >/dev/null; then
    if [ ${#layout_bin} -gt 0 ]; then
      if "${layout_bin[1]}" leave; then
        print -r -- "$HERDR_PANE_ID" >"$layout_state"
      else
        echo "draft-preview: could not leave herdr-layout" >&2
      fi
    fi
  fi
  pane=$(herdr pane split --current --direction right --no-focus | jq -r '.result.pane.pane_id // .result.pane_id // empty')
  [ -n "$pane" ] || { echo "draft-preview: could not split" >&2; exit 1; }
  print -r -- "$pane" >"$state"
else
  herdr pane send-keys "$pane" q >/dev/null 2>&1 || true
fi

herdr pane run "$pane" "glow -w 88 -s ~/.config/glow/muted.json ${(q)file} | less -R"
echo "$pane"
