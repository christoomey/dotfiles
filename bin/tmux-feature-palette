#!/usr/bin/env bash
# tmux-feature-palette — thin launcher for the augie panel TUI (prefix+o).
#
# The old bash+fzf palette was replaced by the Go/Bubble Tea panel in the
# fullstack repo (panel/): per-feature quick actions on its Local tab plus a
# global Sessions tab (open/closed features, mprocs status/kill, up/down/
# open/close). Kept under this name so the .tmux.conf popup binding is
# untouched. The panel handles "not in a feature dir" by opening on the
# Sessions tab, so the old open-app-tab fallback is gone.

set -euo pipefail

root=$(augie-path root 2>/dev/null) || root="$HOME/code/work/august/august-workspace"

exec "$root/tools/bin/panel" "$@"
