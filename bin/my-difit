#!/usr/bin/env bash
#/ Usage: my-difit
#/ Launch a difit code review UI with the right target based on git state.
#/
#/ If there are uncommitted changes (including untracked files), reviews the
#/ working tree. Otherwise reviews the current branch against the merge base
#/ with origin's default branch, freshly fetched, like a GitHub PR diff.
#/
#/ Always runs with --clean (drop stale comments) and --include-untracked.

set -euo pipefail

if [[ -n "$(git status --porcelain)" ]]; then
  exec npx difit working --clean --include-untracked
else
  default_branch="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/master)"
  git fetch --quiet origin "${default_branch#origin/}"
  exec npx difit @ "$default_branch" --merge-base --clean --include-untracked
fi
