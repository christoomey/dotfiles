#!/bin/zsh

# Start (or resume) a one-off Claude session in a project workspace (august,
# moi, dotfiles) from anywhere. Bound to prefix+ctrl+t (popup). Five
# sections on ctrl+1..5 (ctrl+t cycles a section's subtabs):
#   agents            fuzzy finder over live herdr agents (blocked/done
#                     first); enter focuses the pane. `--agents` (bound to
#                     prefix+k) opens straight into it.
#   chats › new       huh form: name (required), project, optional first
#                     prompt, open-vs-background. ctrl+s opens now, ctrl+enter
#                     runs in the background, from any field. ctrl+v
#                     attaches the clipboard image (what CleanShot leaves
#                     after a capture); the launcher moves attachments into
#                     the session's scratch dir and lists their paths in the
#                     first prompt.
#   chats › resume    fuzzy list of past sessions in a project root: enter
#                     resumes one in a new tab (ctrl+enter in the background); a
#                     session that is already live just gets focused.
#   features › new    takes a branch (plus a feature name and a first
#                     prompt that follow it, default `/linear-review <ID>`;
#                     a branch without a Linear id, or a bare feature name,
#                     needs the project picked: august or moi) and runs the project's worktree bootstrap (af up / moi
#                     bin/up) in a new tab, non-interactively; claude starts
#                     on the prompt. ctrl+enter does it all without taking focus.
#   features › sidebar herdr's spaces as the sidebar draws them; J/K or a
#                     mouse drag reorder them live (a worktree among its
#                     siblings, a primary with its whole space), which the
#                     sidebar itself cannot do. enter focuses one.
#   review            optional instructions for /review-queue, started as a
#                     plain chats › new launch in august named "Review queue
#                     <date>"; in the background by default, ctrl+s opens it.
#   debug             a required first prompt for an Abulafia session (pi on
#                     Bedrock, read-only AWS) in august, named from the
#                     prompt's first words. ctrl+enter runs it in the background
#                     and notifies if abulafia is waiting for an MFA code.
# In any prompt box, ctrl+g or ctrl+x ctrl+e edits it in $VISUAL/$EDITOR.
# The popup closes as soon as you submit; the launch continues detached.
#
#   herdr-new-thread [--agents] [--view SECTION] [--project P]   # interactive
#     SECTION: agents | chats | resume | features | sidebar | review | debug
#     P: august | moi | dotfiles (or HERDR_NEW_THREAD_PROJECT, which
#     `herdr plugin pane open --env` can set; see herdr/plugins/new-thread)
#   herdr-new-thread --run-job ID     # detached runner for a queued job
#   herdr-new-thread --watch ID       # detached watchdog for one detach
#   herdr-new-thread --retry ID       # re-run a job (any state but done)
#   herdr-new-thread --sweep          # notify about stranded/stalled jobs, expire old ones
#   herdr-new-thread --jobs [N] [--json]   # recent launches, newest first
#   herdr-new-thread --job ID         # one job's spec, events and logs
#   herdr-new-thread --launch NAME open|bg [SESSION_ID]   # jobless worker (herdr-open-chat)
#
# Every submitted launch is a job on disk under ~/.cache/herdr-threads/jobs/
# (HERDR_THREADS_DIR overrides the base). The form writes <id>.json (the spec,
# prompt included) and the `queued` event before it exits, so the prompt is
# durable before anything can fail; the launcher runs the job through
# herdr-detach, which returns only once the runner is in its own session. A
# plain `nohup ... &!` fork raced the SIGHUP herdr sends the closing popup's
# process group and lost roughly a third of all launches.
#
# Each stage of a run appends a line to <id>.events (claimed, prompt-saved,
# workspace, tab-created, claude-started, acked, done; feature runs add
# bootstrapping and up-exited; debug runs end tab-created, pi-started, done),
# so `--jobs` can say where anything stopped and `--retry` can run it again.
# Nothing is silent: a detach that fails, a runner that never claims its job
# (--watch), a stage that dies, a stalled job (--sweep) and a failed feature
# bootstrap (herdr-job-up) all raise a notification naming the job, its prompt
# file and the retry command.
#
# The new tab's shell gets HERDR_THREAD=1 so zsh/configs/herdr.zsh exits the
# shell when claude does, which closes the pane and the tab, and AUGIE_SCRATCH
# pointing at scratch/<slug>/ under the august root for throwaway files.
# New sessions get `claude --name NAME` so the typed name is the title the
# resume list shows later (Claude persists it as the session's custom title).
# Both the new-session and resume launches go through claude-launch, which
# starts claude, delivers the first prompt from a file, and confirms it landed
# in claude's transcript before reporting success. Prompts are also written to
# chat-prompts/, feature-prompts/ and debug-prompts/, which is what the failure
# notices name; every component logs to ~/.cache/herdr-threads/launch.log
# tagged job=<id>.

set -e

threads="${HERDR_THREADS_DIR:-$HOME/.cache/herdr-threads}"
jobs_dir="$threads/jobs"
self="${0:A}"       # $0 inside a function is the function's name
self_dir="${self:h}"
job_id=""     # the job being run; tags every log line
job_stage=""  # the stage being attempted, for a failed event's detail

tlog() {
  mkdir -p "$threads"
  print -r -- "$(date '+%Y-%m-%d %H:%M:%S') [new-thread:$$]${job_id:+ job=$job_id} $*" >>"$threads/launch.log"
}

job_event() {
  local id="$1" stage="$2" detail="${3:-}"
  mkdir -p "$jobs_dir"
  printf '%s\t%s\t%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$stage" "$detail" >>"$jobs_dir/$id.events"
}

# Events only exist for a job; the legacy --launch path runs without one.
event() {
  [ -n "$job_id" ] || return 0
  job_stage="$1"
  job_event "$job_id" "$1" "${2:-}"
}

job_state() {
  local f="$jobs_dir/$1.events"
  [ -f "$f" ] || return 0
  tail -n1 "$f" | cut -f2
}

notify() {
  herdr notification show "$1" --body "$2" --sound request >/dev/null 2>&1 || true
}

# A banner the user sees while the launch is still booting; must not block the
# runner, and herdr's own sound would fire on every submit.
notify_quiet() {
  { herdr notification show "$1" --body "$2" >/dev/null 2>&1 || true } &!
}

retry_hint() { print -r -- "retry: herdr-new-thread --retry $1"; }

# set -e exits through here; the EXIT trap does not fire for an errexit
# inside a function. A $(...) inherits the trap, so a failure inside one
# logs its own line first and the worker reports once it unwinds.
worker_failed() {
  local rc=$1 where=$2 saved=${pfile:-} reason
  if (( ZSH_SUBSHELL )); then
    tlog "failed (rc=$rc) at $where"
    return
  fi
  # The runner's own stderr is jobs/<id>.err, so the last line there is
  # usually the real message ("tab create returned no pane").
  reason=$(tail -n 5 "$jobs_dir/$job_id.err" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n1)
  [ -z "$reason" ] && reason="rc=$rc at $where"
  tlog "FAILED (rc=$rc) at $where${saved:+; prompt: $saved}"
  if [ -n "$job_id" ]; then
    job_event "$job_id" failed "${job_stage:-?}: $reason"
    notify "New session failed" \
      "$job_id · ${job_stage:-?}: $reason${saved:+ · prompt: $saved} · $(retry_hint "$job_id")"
  else
    notify "New session failed" "launcher died at $where${saved:+ · prompt: $saved}"
  fi
}

august_root() { augie-path root; }

project_root() {
  case "$1" in
    august)   august_root ;;
    moi)      echo "$HOME/code/moi" ;;
    dotfiles) echo "$HOME/code/dotfiles" ;;
    abulafia) echo "$HOME/code/work/august/abulafia" ;;
    *) echo "unknown project: $1" >&2; return 1 ;;
  esac
}

# Workspace id for a project: the non-linked worktree checked out at its root,
# or (dotfiles is a plain folder workspace) the workspace labelled with its name.
find_ws() {
  herdr workspace list | ROOT="$1" LABEL="$2" python3 -c '
import json, os, sys
root, label = os.environ["ROOT"], os.environ["LABEL"]
ws = json.load(sys.stdin)["result"]["workspaces"]
for w in ws:
    wt = w.get("worktree") or {}
    if wt.get("checkout_path") == root and not wt.get("is_linked_worktree"):
        print(w["workspace_id"]); sys.exit()
for w in ws:
    if w.get("label") == label and not w.get("worktree"):
        print(w["workspace_id"]); sys.exit()'
}

ensure_ws() {
  local project="$1" root="$2" ws
  ws=$(find_ws "$root" "$project")
  if [ -z "$ws" ]; then
    if [ "$project" = dotfiles ]; then
      herdr workspace create --cwd "$root" --label "$project" --no-focus >/dev/null
    else
      herdr worktree open --cwd "$root" --path "$root" --no-focus >/dev/null
    fi
    ws=$(find_ws "$root" "$project")
  fi
  [ -z "$ws" ] && { echo "could not find/open $project workspace" >&2; return 1; }
  echo "$ws"
}

first_pane() {
  python3 -c '
import json, sys
def find(o):
    if isinstance(o, dict):
        if "pane_id" in o: return o["pane_id"]
        for v in o.values():
            f = find(v)
            if f: return f
    if isinstance(o, list):
        for v in o:
            f = find(v)
            if f: return f
print(find(json.load(sys.stdin).get("result", {})) or "")'
}

# Open a tab in the project workspace and run its worktree bootstrap there.
# The form supplies everything the `up` scripts would otherwise prompt for
# (--name; moi's prod copy defaults to the snapshot), so the run needs no
# input. The first prompt goes through a file: it can span lines, and the
# pane shell expands "$(cat file)" itself, so nothing is quoted twice. The
# shell exits with the command on success so the tab closes once the
# feature's own tab is arranged; on failure it stays open with the error.
# feature-bg keeps focus where it is throughout.
launch_feature() {
  local form project branch name prompt mode root ws pane cmd focus perr
  form=$(cat)
  project=$(printf '%s' "$form" | jq -r .project)
  branch=$(printf '%s' "$form" | jq -r .branch)
  name=$(printf '%s' "$form" | jq -r .name)
  prompt=$(printf '%s' "$form" | jq -r '.prompt // ""')
  mode=$(printf '%s' "$form" | jq -r .mode)
  tlog "feature $project $branch ($mode)"

  local -a args=(--name "$name")
  focus="--focus"
  if [ "$mode" = feature-bg ]; then
    focus="--no-focus"
    args+=(--no-focus)
  fi
  if [ -n "$prompt" ]; then
    local pdir="$threads/feature-prompts"
    mkdir -p "$pdir"
    pfile="$pdir/$name-$(date +%Y%m%d-%H%M%S).md"
    printf '%s\n' "$prompt" > "$pfile"
    tlog "feature prompt saved to $pfile"
    event prompt-saved "$pfile"
    args+=(--prompt-file "$pfile")
  fi

  root=$(project_root "$project")
  ws=$(ensure_ws "$project" "$root")
  tlog "feature: workspace $ws"
  event workspace "$ws"

  case "$project" in
    august) args+=("$branch"); cmd="af up ${(j: :)${(q)args[@]}}" ;;
    moi)    args+=(--snapshot "$branch"); cmd="bin/up ${(j: :)${(q)args[@]}}" ;;
    *) echo "$project has no feature flow" >&2; return 1 ;;
  esac
  # herdr-job-up tees the bootstrap to the job log and reports how it ended;
  # it exits with the bootstrap's own status, so `&& exit` still closes the tab.
  [ -n "$job_id" ] && cmd="${(q)self_dir}/herdr-job-up ${(q)job_id} -- $cmd"
  cmd="$cmd && exit"

  pane=$(herdr tab create --workspace "$ws" --cwd "$root" --label "up: ${branch##*/}" $focus | first_pane)
  [ -z "$pane" ] && { echo "tab create returned no pane" >&2; return 1; }
  event tab-created "$pane"
  perr=""
  for i in {1..40}; do
    if perr=$(herdr pane run "$pane" "$cmd" 2>&1); then
      tlog "feature: bootstrap running in $pane"
      return 0
    fi
    sleep 0.25
  done
  tlog "pane run kept failing: $perr"
  echo "pane $pane never accepted the command: $perr" >&2
  return 1
}

launch() {
  local name="$1" mode="$2" session_id="${3:-}" form prompt project
  form=$(cat)
  prompt=$(printf '%s' "$form" | jq -r '.prompt // ""')
  project=$(printf '%s' "$form" | jq -r '.project // "august"')
  tlog "launch \"$name\" $project ($mode${session_id:+, resume $session_id}, prompt ${#prompt} chars)"

  local slug
  slug=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
  [ -z "$slug" ] && slug="session"

  # The prompt only exists in the form JSON piped over stdin (and the form's
  # draft), so it goes to disk before anything that can fail. claude-launch
  # starts claude on this file and names it in any failure notice.
  pfile=""
  if [ -n "$prompt" ]; then
    local pdir="$threads/chat-prompts"
    mkdir -p "$pdir"
    pfile="$pdir/$slug-$(date +%Y%m%d-%H%M%S).md"
    printf '%s\n' "$prompt" > "$pfile"
    tlog "prompt saved to $pfile"
    event prompt-saved "$pfile"
  fi

  local root ws
  root=$(project_root "$project")
  ws=$(ensure_ws "$project" "$root")
  tlog "workspace $ws ($root)"
  event workspace "$ws"

  local focus="--focus"
  [ "$mode" = "bg" ] && focus="--no-focus"

  # Per-session scratch dir; august's CLAUDE.md tells Claude to write throwaway
  # files here. Other projects keep it out of the repo.
  local scratch="$root/scratch/$slug"
  [ "$project" = august ] || scratch="$threads/$project/$slug"
  mkdir -p "$scratch"

  local -a attached
  local src dest attach_dir=""
  while IFS= read -r src; do
    [ -f "$src" ] || continue
    attach_dir=$(dirname "$src")
    dest="$scratch/$(basename "$src")"
    [ -e "$dest" ] && dest="$scratch/$(date +%H%M%S)-$(basename "$src")"
    mv "$src" "$dest" && attached+=("$dest")
  done < <(printf '%s' "$form" | jq -r '.attachments[]?')
  if [ ${#attached[@]} -gt 0 ]; then
    rmdir "$attach_dir" 2>/dev/null || true
    prompt+=$'\n\nAttached screenshots:'
    for dest in "${attached[@]}"; do prompt+=$'\n- '"$dest"; done
    prompt="${prompt#$'\n\n'}"
    if [ -z "$pfile" ]; then
      pfile="$threads/chat-prompts/$slug-$(date +%Y%m%d-%H%M%S).md"
      mkdir -p "${pfile:h}"
    fi
    printf '%s\n' "$prompt" > "$pfile"
    tlog "attached ${#attached[@]} screenshot(s) to $pfile"
    event prompt-saved "$pfile"
  fi

  # /review-queue publishes a report artifact per PR for Perspective; Claude
  # Code would otherwise open each one in the browser as it lands.
  local -a envs=(--env HERDR_THREAD=1 --env AUGIE_SCRATCH="$scratch")
  [[ "$prompt" == /review-queue* ]] && envs+=(--env CLAUDE_CODE_ARTIFACT_AUTO_OPEN=0)

  local pane
  pane=$(
    herdr tab create --workspace "$ws" --cwd "$root" --label "$name" \
      "${envs[@]}" $focus | first_pane
  )
  [ -z "$pane" ] && { echo "tab create returned no pane" >&2; return 1; }
  tlog "tab created, pane $pane"
  event tab-created "$pane"

  # Agent names must match ^[a-z][a-z0-9_-]*$ and be <= 32 chars; resumed
  # session titles are usually longer, so cap the base and leave room for a
  # collision suffix.
  local base
  base=$(printf '%s' "${slug:0:23}" | sed -E 's/-+$//')
  case "$base" in
    [a-z]*) ;;
    *) base="s-$base" ;;
  esac

  # claude-launch starts claude through the pane's shell (so the prompt can
  # span lines, which `herdr agent start` refuses) and waits for the prompt to
  # show up in claude's transcript, notifying on anything less.
  local -a launch_args=(--pane "$pane" --agent-name "$base")
  if [ -n "$session_id" ]; then
    launch_args+=(--resume "$session_id")
  else
    launch_args+=(--name "$name")
  fi
  [ -n "$pfile" ] && launch_args+=(--prompt-file "$pfile")
  [ -n "$job_id" ] && launch_args+=(--job "$job_id")
  tlog "handing pane $pane to claude-launch"
  job_stage="claude-started"
  claude-launch "${launch_args[@]}"
}

# A debug job: an Abulafia session (pi on Bedrock) in august, in front or in
# the background; abulafia may stop for an MFA code. herdr-abulafia-launch reads the
# prompt from its file inside the pane, so it can span lines. herdr only
# lists the pane as a pi agent once pi itself runs, which can wait on that
# MFA code; the sidebar tokens go on after that.
launch_debug() {
  local form name mode prompt slug root ws scratch pane cmd perr agent i left wait=240 focus=--focus
  form=$(cat)
  name=$(printf '%s' "$form" | jq -r .name)
  mode=$(printf '%s' "$form" | jq -r '.mode // "open"')
  prompt=$(printf '%s' "$form" | jq -r '.prompt // ""')
  tlog "debug \"$name\" ($mode, prompt ${#prompt} chars)"
  [ "$mode" = bg ] && focus=--no-focus
  [ -z "$prompt" ] && { echo "debug job has no prompt" >&2; return 1; }

  slug=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
  [ -z "$slug" ] && slug="debug"
  local pdir="$threads/debug-prompts"
  mkdir -p "$pdir"
  pfile="$pdir/$slug-$(date +%Y%m%d-%H%M%S).md"
  printf '%s\n' "$prompt" > "$pfile"
  tlog "debug prompt saved to $pfile"
  event prompt-saved "$pfile"

  # Refresh an expiring session here, before the tab exists: the 1Password
  # Touch ID dialog shows over whatever app is in front, so a background
  # launch stays in the background. With no TTY abulafia-session fails
  # instead of prompting, and the tab's own MFA prompt takes over below.
  left=$(abulafia-session status 2>/dev/null | jq -r '.secondsLeft // -1' 2>/dev/null)
  if (( ${left:--1} < 600 )); then
    tlog "abulafia session has ${left:-?}s left; refreshing before the tab opens"
    if abulafia-session ensure </dev/null 2>>"$threads/launch.log"; then
      tlog "abulafia session refreshed"
    else
      tlog "abulafia session refresh failed; the tab will prompt"
    fi
  fi

  root=$(august_root)
  ws=$(ensure_ws august "$root")
  tlog "workspace $ws ($root)"
  event workspace "$ws"

  scratch="$root/scratch/$slug"
  mkdir -p "$scratch"
  local -a envs=(--env HERDR_THREAD=1 --env AUGIE_SCRATCH="$scratch")
  [ -n "${HERDR_DEBUG_CMD:-}" ] && envs+=(--env HERDR_DEBUG_CMD="$HERDR_DEBUG_CMD")
  pane=$(herdr tab create --workspace "$ws" --cwd "$root" --label "$name" "${envs[@]}" $focus | first_pane)
  [ -z "$pane" ] && { echo "tab create returned no pane" >&2; return 1; }
  tlog "tab created, pane $pane"
  event tab-created "$pane"

  cmd="${(q)self_dir}/herdr-abulafia-launch ${(q)pfile} ${(q)name}"
  local ran=0
  perr=""
  for i in {1..40}; do
    if perr=$(herdr pane run "$pane" "$cmd" 2>&1); then
      ran=1
      break
    fi
    sleep 0.25
  done
  if (( ! ran )); then
    tlog "pane run kept failing: $perr"
    echo "pane $pane never accepted the abulafia command: $perr" >&2
    return 1
  fi
  tlog "abulafia starting in $pane"

  # Still expiring means the refresh above failed and the tab is prompting:
  # say so for a background launch, and give the code up to 15 minutes to
  # arrive instead of failing at 2.
  left=$(abulafia-session status 2>/dev/null | jq -r '.secondsLeft // -1' 2>/dev/null)
  if (( ${left:--1} < 600 )); then
    wait=1800
    tlog "abulafia session has ${left:-?}s left; MFA code needed in $pane"
    [ "$mode" = bg ] && notify "Abulafia needs an MFA code" "\"$name\" is waiting in its august tab"
  fi

  job_stage="pi-started"
  agent=""
  for (( i = 0; i < wait; i++ )); do
    agent=$(herdr agent get "$pane" 2>/dev/null | jq -r '.result.agent.agent // ""')
    [ "$agent" = pi ] && break
    sleep 0.5
  done
  if [ "$agent" != pi ]; then
    echo "pi never started in pane $pane within $(( wait / 2 ))s (MFA not entered, or abulafia failed; see the tab)" >&2
    return 1
  fi
  event pi-started "$pane"
  herdr pane report-metadata "$pane" --source dotfiles-sidebar \
    --token debug=debug --token "name=$name" \
    --clear-token review --clear-token feature --clear-token chat --clear-token project >/dev/null
  tlog "pi running in $pane; sidebar labelled"
}

# The runner for one job. mkdir is the claim: a second runner (a retry racing
# the watchdog, say) finds the directory there and leaves without doing
# anything. The spec is the form's, so the prompt survives everything below.
run_job() {
  local id="$1" spec mode name project sid lmode
  spec="$jobs_dir/$id.json"
  if [ ! -f "$spec" ]; then
    tlog "job=$id has no spec at $spec"
    exit 1
  fi
  if ! mkdir "$jobs_dir/$id.claim" 2>/dev/null; then
    tlog "job=$id already claimed; nothing to do"
    exit 0
  fi
  job_id="$id"
  pfile=""
  trap 'worker_failed $? "${funcfiletrace[1]:-?}"' ZERR
  event claimed ""

  mode=$(jq -r '.mode // ""' "$spec")
  name=$(jq -r '.name // ""' "$spec")
  project=$(jq -r '.project // ""' "$spec")
  tlog "claimed \"$name\" ($mode, $project)"
  notify_quiet "Starting $name…" "$project · $mode"

  case "$mode" in
    feature|feature-bg)
      # herdr-job-up owns done/failed from the moment the bootstrap starts.
      launch_feature < "$spec"
      ;;
    open|bg|resume|resume-bg)
      if [ "$(jq -r '.kind // ""' "$spec")" = debug ]; then
        launch_debug < "$spec"
        event done ""
        tlog "done"
        return 0
      fi
      sid=$(jq -r '.session_id // ""' "$spec")
      lmode=open
      case "$mode" in bg|resume-bg) lmode=bg ;; esac
      launch "$name" "$lmode" "$sid" < "$spec"
      event done ""
      tlog "done"
      ;;
    *)
      echo "job $id has no launchable mode: $mode" >&2
      return 1
      ;;
  esac
}

# Independent of the runner: if nothing claimed the job, the detach or the
# runner itself died and only the user can decide what to do about it.
watch_job() {
  local id="$1" name
  sleep 15
  if [ -d "$jobs_dir/$id.claim" ] || [ ! -f "$jobs_dir/$id.json" ]; then
    return 0
  fi
  if [ -e "$jobs_dir/$id.stranded-notified" ]; then
    return 0
  fi
  : > "$jobs_dir/$id.stranded-notified"
  name=$(jq -r '.name // ""' "$jobs_dir/$id.json")
  tlog "job=$id launch never started"
  notify "Launch never started" "$name · job $id · $(retry_hint "$id")"
  return 0
}

detach_job() {
  local id="$1" name
  mkdir -p "$jobs_dir"
  if "$self_dir/herdr-detach" --log "$jobs_dir/$id.err" -- "$self" --run-job "$id"; then
    tlog "detached runner for job $id"
    if ! "$self_dir/herdr-detach" --log "$jobs_dir/$id.err" -- "$self" --watch "$id"; then
      tlog "watchdog detach failed for job $id"
    fi
    return 0
  fi
  name=$(jq -r '.name // ""' "$jobs_dir/$id.json" 2>/dev/null)
  tlog "detach FAILED for job $id; it stays queued"
  notify "Launch not started" "$name · the worker could not be detached · job $id · $(retry_hint "$id")"
  return 1
}

retry_job() {
  local id="$1" state
  if [ ! -f "$jobs_dir/$id.json" ]; then
    echo "no such job: $id" >&2
    exit 1
  fi
  state=$(job_state "$id")
  if [ "$state" = done ]; then
    echo "job $id is already done" >&2
    exit 1
  fi
  rm -rf "$jobs_dir/$id.claim" "$jobs_dir/$id.stranded-notified" "$jobs_dir/$id.stalled-notified"
  job_event "$id" retry ""
  detach_job "$id"
}

# Notices for launches nobody is watching, plus the 14-day retention. Runs
# detached at every popup open, and marks each job it has complained about so
# the next open stays quiet.
sweep() {
  local now f id state age spec name mode limit
  now=$(date +%s)
  for f in "$jobs_dir"/*.events(N); do
    id=${${f:t}%.events}
    spec="$jobs_dir/$id.json"
    state=$(job_state "$id")
    age=$(( now - $(stat -f %m "$f") ))
    case "$state" in
      done|failed|superseded)
        if (( age > 14 * 86400 )); then
          rm -rf "$jobs_dir/$id".*(N)
          tlog "retention: removed job $id"
        fi
        continue
        ;;
    esac
    name=$(jq -r '.name // ""' "$spec" 2>/dev/null)
    mode=$(jq -r '.mode // ""' "$spec" 2>/dev/null)
    if [ ! -d "$jobs_dir/$id.claim" ]; then
      if [ "$state" = queued ] && (( age > 10 )) && [ ! -e "$jobs_dir/$id.stranded-notified" ]; then
        : > "$jobs_dir/$id.stranded-notified"
        tlog "stranded job $id (queued ${age}s ago, never claimed)"
        notify "Launch never started" "$name · queued ${age}s ago with no worker · job $id · $(retry_hint "$id")"
      fi
      continue
    fi
    limit=180
    case "$mode" in feature|feature-bg) limit=1200 ;; esac
    if (( age > limit )) && [ ! -e "$jobs_dir/$id.stalled-notified" ]; then
      : > "$jobs_dir/$id.stalled-notified"
      tlog "stalled job $id (stage $state for ${age}s)"
      notify "Launch stalled" "$name · stuck at $state for $((age / 60))m · job $id · $(retry_hint "$id")"
    fi
  done
}

jobs_table() {
  local n=15 as_json=0 arg
  for arg in "$@"; do
    case "$arg" in
      --json) as_json=1 ;;
      <->) n="$arg" ;;
      *) echo "usage: herdr-new-thread --jobs [N] [--json]" >&2; exit 2 ;;
    esac
  done
  JOBS_DIR="$jobs_dir" JOBS_N="$n" JOBS_JSON="$as_json" python3 -c '
import json, os, time

jobs = os.environ["JOBS_DIR"]
limit = int(os.environ["JOBS_N"])
as_json = os.environ["JOBS_JSON"] == "1"
TERMINAL = ("done", "failed", "superseded")

def stamp(text):
    try:
        return time.mktime(time.strptime(text, "%Y-%m-%d %H:%M:%S"))
    except ValueError:
        return None

def ago(seconds):
    if seconds is None:
        return "?"
    seconds = int(seconds)
    for size, unit in ((86400, "d"), (3600, "h"), (60, "m")):
        if seconds >= size:
            return "%d%s" % (seconds // size, unit)
    return "%ds" % seconds

try:
    names = os.listdir(jobs)
except OSError:
    names = []
ids = sorted({n[:-5] for n in names if n.endswith(".json")} |
             {n[:-7] for n in names if n.endswith(".events")}, reverse=True)[:limit]

rows = []
for jid in ids:
    try:
        with open(os.path.join(jobs, jid + ".json")) as fh:
            spec = json.load(fh)
    except Exception:
        spec = {}
    events = []
    try:
        with open(os.path.join(jobs, jid + ".events")) as fh:
            for line in fh:
                if line.strip():
                    parts = line.rstrip("\n").split("\t")
                    events.append(parts + [""] * (3 - len(parts)))
    except OSError:
        pass
    stage = events[-1][1] if events else "queued"
    detail = events[-1][2] if events else ""
    started = stamp(events[0][0]) if events else None
    ended = stamp(events[-1][0]) if events and stage in TERMINAL else None
    rows.append({
        "id": jid,
        "age_seconds": int(time.time() - started) if started else None,
        "mode": spec.get("mode", ""),
        "project": spec.get("project", ""),
        "name": spec.get("name", ""),
        "stage": stage,
        "detail": detail,
        "duration_seconds": round(ended - started, 1) if started and ended else None,
        "prompt_chars": len(spec.get("prompt", "") or ""),
        "claimed": os.path.isdir(os.path.join(jobs, jid + ".claim")),
    })

if as_json:
    print(json.dumps(rows, indent=2))
else:
    fmt = "%%-%ds %%5s %%-11s %%-8s %%-26s %%-14s %%7s %%7s" % max([2] + [len(r["id"]) for r in rows])
    print(fmt % ("ID", "AGE", "MODE", "PROJECT", "NAME", "STAGE", "TOOK", "PROMPT"))
    for row in rows:
        print(fmt % (
            row["id"], ago(row["age_seconds"]), row["mode"][:11],
            row["project"][:8], row["name"][:26], row["stage"][:14],
            ("%.1fs" % row["duration_seconds"]) if row["duration_seconds"] is not None else "-",
            row["prompt_chars"]))
        if row["stage"] == "failed" and row["detail"]:
            print("    %s" % row["detail"])
    if not rows:
        print("(no jobs)")
'
}

job_show() {
  local id="$1"
  if [ ! -f "$jobs_dir/$id.json" ] && [ ! -f "$jobs_dir/$id.events" ]; then
    echo "no such job: $id" >&2
    exit 1
  fi
  echo "spec: $jobs_dir/$id.json"
  jq . "$jobs_dir/$id.json" 2>/dev/null || echo "(missing)"
  echo
  echo "events:"
  cat "$jobs_dir/$id.events" 2>/dev/null || echo "(none)"
  echo
  echo "claimed: $([ -d "$jobs_dir/$id.claim" ] && echo yes || echo no)"
  echo "runner log: $jobs_dir/$id.err"
  echo "bootstrap log: $jobs_dir/$id.up.log"
}

case "${1:-}" in
  --run-job)
    tlog "runner started for ${2:-?}"
    run_job "${2:?job id required}"
    exit
    ;;
  --watch)
    watch_job "${2:?job id required}"
    exit
    ;;
  --retry)
    retry_job "${2:?job id required}"
    exit
    ;;
  --sweep)
    sweep
    exit
    ;;
  --jobs)
    shift
    jobs_table "$@"
    exit
    ;;
  --job)
    job_show "${2:?job id required}"
    exit
    ;;
  --launch)
    # Jobless worker, form JSON on stdin; herdr-open-chat resumes through it.
    tlog "worker started (--launch)"
    pfile=""
    trap 'worker_failed $? "${funcfiletrace[1]:-?}"' ZERR
    launch "$2" "$3" "${4:-}"
    exit
    ;;
esac

# Detached so it never delays the form.
"$self_dir/herdr-detach" --log "$threads/sweep.log" -- "$self" --sweep >/dev/null 2>&1 || true

# Self-building form binary (herdr/new-session-form, charmbracelet/bubbletea).
form_src="${0:A:h}/../herdr/new-session-form"
form_bin="$form_src/herdr-new-session-form"
if [ ! -x "$form_bin" ] || [ -n "$(find "$form_src" -name '*.go' -newer "$form_bin" -print -quit)" ]; then
  (cd "$form_src" && go build -o "$form_bin" .) || { echo "form build failed" >&2; sleep 3; exit 1; }
fi

form_args=(--theme minimal)
[ -n "${HERDR_NEW_THREAD_PROJECT:-}" ] && form_args+=(--project "$HERDR_NEW_THREAD_PROJECT")
while [ $# -gt 0 ]; do
  case "$1" in
    --agents) form_args+=(--view agents); shift ;;
    --view|--project) form_args+=("$1" "$2"); shift 2 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

rc=0
result=$("$form_bin" "${form_args[@]}") || rc=$?
if [ $rc -ne 0 ] || [ -z "$result" ]; then
  tlog "form closed without a result (rc=$rc)"
  exit 0
fi

mode=$(printf '%s' "$result" | jq -r .mode)
tlog "form result: $mode \"$(printf '%s' "$result" | jq -r '.name // ""')\""
if [ "$mode" = focus ]; then
  herdr tab focus "$(printf '%s' "$result" | jq -r .tab_id)" >/dev/null
  exit 0
fi
if [ "$mode" = workspace ]; then
  herdr workspace focus "$(printf '%s' "$result" | jq -r .workspace_id)" >/dev/null
  exit 0
fi
if [ "$mode" = agent ]; then
  # Tab first, then the pane: agent focus alone does not always raise the tab
  # in a multi-tab workspace (same two-step herdr-bar used).
  herdr tab focus "$(printf '%s' "$result" | jq -r .tab_id)" >/dev/null
  herdr agent focus "$(printf '%s' "$result" | jq -r .pane_id)" >/dev/null
  exit 0
fi
if [ "$mode" = retry ]; then
  retry_job "$(printf '%s' "$result" | jq -r .job_id)"
  exit
fi

name=$(printf '%s' "$result" | jq -r .name)
if [ -z "$name" ]; then
  tlog "form result has no name; nothing to launch"
  exit 0
fi

# The form writes the job spec and its queued event before it prints; older
# builds did not, and a launch is never worth losing over that.
id=$(printf '%s' "$result" | jq -r '.job_id // ""')
if [ -z "$id" ] || [ ! -f "$jobs_dir/$id.json" ]; then
  slug=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
  [ -z "$slug" ] && slug=session
  id="$(date +%Y%m%d-%H%M%S)-${slug:0:40}-$(printf '%04x' $RANDOM)"
  mkdir -p "$jobs_dir"
  printf '%s' "$result" | jq -c --arg id "$id" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{
    id: $id, created_at: $at, mode: .mode, kind: (.kind // ""), project: (.project // ""),
    name: (.name // ""), branch: (.branch // ""), prompt: (.prompt // ""),
    attachments: (.attachments // []), session_id: (.session_id // "")
  }' >"$jobs_dir/$id.json.tmp"
  mv "$jobs_dir/$id.json.tmp" "$jobs_dir/$id.json"
  job_event "$id" queued ""
  tlog "form returned no job_id; wrote $jobs_dir/$id.json"
fi

# Detach so the popup closes on submit; claude takes several seconds to boot.
# herdr-detach returns only once the runner has its own session, out of reach
# of the SIGHUP herdr sends this popup's process group.
detach_job "$id" || exit 1
