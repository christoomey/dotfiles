#!/usr/bin/env bash
# Finish the Hex dictation and submit it to the focused Claude pane in herdr.
# Anywhere else it finishes normally, pasting without Enter.

set -u
PATH="$PATH:/opt/homebrew/bin:/Applications/Hex.app/Contents/MacOS"

# herdr's API doesn't expose popups, and the pane behind one still reports
# focused. A popup is an extra terminal under the server that isn't a pane, so
# any mismatch means "don't submit": a plain paste is the safe failure.
popup_may_be_open() {
  local panes_json="$1" processes server terminals
  processes=$(ps -axo pid=,ppid=,tty=,command=)
  server=$(printf '%s\n' "$processes" | awk 'NF == 5 && $4 ~ /\/herdr$/ && $5 == "server" { print $1 }')
  if [ "$(printf '%s' "$server" | wc -w)" -ne 1 ]; then
    return 0
  fi
  terminals=$(printf '%s\n' "$processes" | awk -v server="$server" '$2 == server && $3 != "??"' | wc -l)
  [ "$terminals" -ne "$(printf '%s' "$panes_json" | jq '(.result.panes // .panes) | length')" ]
}

focused_claude_pane() {
  local panes_json
  panes_json=$(herdr pane list)
  if ! popup_may_be_open "$panes_json"; then
    printf '%s' "$panes_json" | jq -r '(.result.panes // .panes)[] | select(.focused and .agent == "claude") | .pane_id' | head -n 1
  fi
}

front=$(lsappinfo info -only bundleid "$(lsappinfo front)" | sed -n 's/.*bundleID="\(.*\)".*/\1/p')
pane=""
if [ "$front" = "com.mitchellh.ghostty" ]; then
  pane=$(focused_claude_pane)
fi

# Never use `hex paste-last` here: --print dictations don't count as "last",
# so it would paste an older dictation.
if [ -z "$pane" ]; then
  if [ "$front" = "sh.paseo.desktop" ]; then
    # The Paseo inbox plugin presses Enter after this paste if a message box has focus.
    mkdir -p "$HOME/.cache/paseo-inbox"
    touch "$HOME/.cache/paseo-inbox/dictation-submit"
  fi
  exec hex dictation stop
fi

text=$(hex dictation stop --print) || exit 0
text=$(printf '%s' "$text" | tr '\r\n' '  ' | sed -e 's/^ *//' -e 's/ *$//')
if [ -n "$text" ]; then
  if herdr pane send-text "$pane" "$text"; then
    herdr pane send-keys "$pane" enter
  else
    printf '%s' "$text" | pbcopy
  fi
fi
