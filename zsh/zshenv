eval "$(/opt/homebrew/bin/brew shellenv)"

# Add homebrew binaries
export PATH="/usr/local/bin:$PATH"
export HOMEBREW_NO_AUTO_UPDATE=1

# Add my custom commands
export PATH="$HOME/bin:$PATH"

export PATH="$HOME/.npm-packages/bin:$PATH"

export JAVA_HOME="$HOME/.java_home"
export NODE_GYP_FORCE_PYTHON=/opt/homebrew/bin/python3.10

# Use postgres.app versions of pg utilites
export PATH=/Applications/Postgres.app/Contents/Versions/latest/bin:$PATH

# asdf shims must be on PATH in ALL shells (not just interactive), so
# non-interactive contexts (herdr/tmux-spawned jobs) don't fall back to
# homebrew node. Completions stay in .zshrc.
. $HOME/.asdf/asdf.sh

# herdr sets TERM_PROGRAM=herdr, which Claude Code doesn't recognize, so it
# prints links as "text (url)". herdr renders OSC 8 fine (ctrl-click opens).
# https://github.com/herdrdev/herdr/issues/4748
[ "$TERM_PROGRAM" = herdr ] && export FORCE_HYPERLINK=1
